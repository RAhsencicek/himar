# ==========================================================
# Hİ MARKET - POS & STOK YÖNETİM SİSTEMİ (.env.example)
# ==========================================================

SECRET_KEY=change-this-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,0.0.0.0

# Veritabanı Yapılandırması (sqlite3 veya postgresql)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# DB_ENGINE=postgresql
# DB_NAME=himarket_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Kasa Terminal & API Güvenlik Anahtarı
POS_API_TOKEN=himarket-pos-terminal-token-2026

# ESC/POS Termal Yazıcı ve Donanım Ayarları
ESC_POS_ENABLED=True
PRINTER_MODE=SPOOL_AND_SOCKET
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100
PRINTER_NAME=POS-80
CASH_DRAWER_KICK_ON_CASH=True
